---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import boxImg from '../../assets/photos/box.jpg';
import { site, linkOr } from '../../data/site';

const apps = [
  { name: 'GrabFood', href: linkOr(site.links.grabfood) },
  { name: 'GoFood', href: linkOr(site.links.gofood) },
];
---

<section id="pesan" class="section order">
  <div class="container">
    <h2 class="display section-title" data-reveal>Lapar? Tinggal pesan.</h2>
    <p class="lead" data-reveal>
      Pesan antar lewat aplikasi favoritmu, atau chat kami untuk pesanan kantor dan acara.
    </p>

    <div class="order__grid">
      <ul class="order__apps" role="list" data-reveal="stagger">
        {
          apps.map((app) => (
            <li>
              <a class="link-card order__app" href={app.href}>
                <span class="link-card__icon">
                  <Icon name="bag" size={24} />
                </span>
                <span class="link-card__text">
                  <span class="card-title">{app.name}</span>
                  <span class="link-card__sub">Cari “{site.name}”</span>
                </span>
                <Icon name="arrow-right" strokeWidth={2.4} />
              </a>
            </li>
          ))
        }
      </ul>

      <article class="corporate" data-reveal>
        <Picture
          src={boxImg}
          alt="Ayam bumbu, tempe, tahu dan bumbu dalam box Spiring"
          widths={[300, 450, 600]}
          sizes="(min-width: 1024px) 260px, (min-width: 600px) 40vw, 90vw"
          formats={['avif', 'webp']}
          pictureAttributes={{ class: 'corporate__media' }}
        />
        <div class="corporate__body">
          <span class="corporate__kicker">
            <Icon name="briefcase" size={18} />
            Corporate orders
          </span>
          <h3 class="display corporate__title">Pesanan kantor &amp; acara</h3>
          <p>Makan siang tim, rapat, arisan, sampai syukuran. Pesan dalam box, kami siapkan.</p>
          <a class="btn btn--primary" href={linkOr(site.links.whatsapp)}>
            <Icon name="chat" size={20} />
            Chat via WhatsApp
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .order {
    background: var(--yellow);
    border-bottom: 2px solid var(--ink);
  }

  .order .lead {
    color: var(--ink);
  }

  .order__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 32px;
    margin-top: 40px;
  }

  .order__apps {
    display: flex;
    flex: 1 1 360px;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .order__app {
    min-height: 84px;
    padding: 14px 20px 14px 14px;
    border-radius: 20px;
    box-shadow: 0 6px 0 var(--ink);
  }

  .order__app .link-card__icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
  }

  .corporate {
    display: flex;
    flex: 1.3 1 440px;
    flex-wrap: wrap;
    min-width: 0;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 28px;
    background: var(--cream);
    box-shadow: 0 6px 0 var(--ink);
  }

  .corporate :global(.corporate__media) {
    flex: 1 1 200px;
    min-width: 0;
    min-height: 260px;
  }

  /* Once the photo stacks above the text, keep the tall box photo from taking over. */
  @media (max-width: 559px) {
    .corporate :global(.corporate__media) {
      height: 280px;
    }
  }

  .corporate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .corporate__body {
    display: flex;
    flex: 1.4 1 260px;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    padding: 28px;
  }

  .corporate__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red-text);
  }

  .corporate__title {
    font-size: 26px;
    font-stretch: 112%;
    line-height: 1.05;
  }

  .corporate__body p {
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .corporate__body .btn {
    margin-top: 6px;
  }
</style>
